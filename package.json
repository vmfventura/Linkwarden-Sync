{
  "name": "linkwarden-sync",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs all",
    "test:browser:ui": "node scripts/browser-smoke.mjs all --ui",
    "demo": "vite --config demo/vite.config.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
